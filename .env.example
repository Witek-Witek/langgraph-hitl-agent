# Tracing (LangSmith)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=<your-api-key>
LANGSMITH_PROJECT=langgraph-stage<no>


# LLM
ANTHROPIC_API_KEY=<your-api-key>
GOOGLE_API_KEY=<your-api-key>
OPENAI_API_KEY=<your-api-key>
OPENROUTER_API_KEY=<your-api-key>
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Warstwa modelu: rola → specyfikacja (provider:model) ---
# Modele Anthropic: "claude-haiku-4-5"
# Modele OpenAI: "gpt-4o-mini", "gpt-4o", gpt-5-nano", "gpt-5-nano-2025-08-07", "gpt-5.6-luna"
# Model OpenRouter: 
## DARMOWE: mistralai/mistral-small:free / devstralgoogle/gemini-2.5-flash:free / gemini-3-flash:freenvidia/nemotron-4-340b-instruct:free
## ULTRA TANIE (KLASA FLASH): deepseek/deepseek-chat (v3)qwen/qwen-2.5-coder-32b-instructgoogle/gemini-2.5-flash
## BUDŻETOWE ROZUMUJĄCE (REASONING): openai/o1-minideepseek/deepseek-r1

LLM_MAIN=anthropic:claude-haiku-4-5
LLM_CLASSIFIER=openai:gpt-4o-mini
LLM_DISTILLER=<prefiks:model>
LLM_TEMPERATURE=                         
# LLM_TEMPERATURE zostaje puste = nie przekazuj parametru

LLM_DEFAULT_PROFILE=balanced
LLM_DEFAULT_PERSONA=neutral

# Inne modele OpenAI compatible API (LM Studio, vLLM, Ollama itd)
# Dodać również role wyżej, np. LLM_DESTILLER=custom:llama-3.3-70b
CUSTOM_BASE_URL=http://localhost:8080/v1     # dla prefiksu custom:
CUSTOM_API_KEY=<your-api-key>
CUSTOM_MODEL_PROVIDER=<provider>  # np. "openai", "anthropic", "mistral", "llama", "vllm" itd.

# Protokół PostgreSQL (Supabase)
DATABASE_URL=postgresql://postgres:<haslo>@<host>:5432/postgres?sslmode=require

# Supabase
SUPABASE_URL=https://<ref>.supabase.co   
# <ref> to identyfikator projektu
SUPABASE_ANON_KEY=<your-api-key>
SUPABASE_PUBLISHABLE_KEY=<sb_publishable_your-api-key>

# CORS
CORS_ORIGINS=http://localhost:<XXXX>,http://localhost:<XXXX>

# Workspace
WORKSPACE_DIR=./workspace